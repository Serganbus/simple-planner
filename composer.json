{
    "name": "serganbus/planner-cli",
    "description": "Personal planner CLI tool",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "symfony/console": "^6.0|^7.0",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Planner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Planner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "bin": ["bin/planner"],
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
